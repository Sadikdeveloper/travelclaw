# Gateway
HOST=0.0.0.0
PORT=3000

# Paths are resolved from apps/api when you use the package scripts.
DATABASE_PATH=../../data/travelclaw.db
# The shared persona files live here. An agent reads its own copy of any file it
# has under WORKSPACE_PATH/agents/<id>/ and falls back to the shared one otherwise.
WORKSPACE_PATH=../../workspace

# mock runs the deterministic router and renders its results. A live provider may call the
# same tools, then narrates what they returned. The provider is only a default: the configured
# model id below decides which provider a turn actually uses.
TRAVELCLAW_MODEL_PROVIDER=mock
TRAVELCLAW_MODEL_BASE_URL=https://api.openai.com/v1
TRAVELCLAW_MODEL_API_KEY=
# The desk runs the strongest model it can run; nobody selects one. These two say which
# models exist here. A live model needs a provider key, and appears as unavailable without
# one. A turn limit belongs to a model (the desk's own model has none); the numbers live in
# apps/api/src/models/model-catalog.ts.
TRAVELCLAW_MODEL_NAME=gpt-4o-mini
TRAVELCLAW_MODELS=gpt-4o-mini,gpt-4o

# Google Gemini (optional). This is for Gemini the model, not Google sign-in below.
# Replace the MODEL_PROVIDER, MODEL_NAME, and MODELS values above with these values, then
# restart the API. GET /api/models should report `gemini-3.8-flash` as `available: true`
# and `current`. GEMINI_API_KEY is accepted as an alias for TRAVELCLAW_GOOGLE_API_KEY.
# `gemini-flash` and `gemini-pro` are accepted too, but a canonical id avoids provider-side
# 404s. Use the current generation: a Gemini API key created now answers 404 for 2.5 ids
# ("no longer available to new users"), so `TRAVELCLAW_MODEL_NAME=gemini-2.5-pro` falls
# back to the desk renderer. Ask the key what it can run with
#   curl https://generativelanguage.googleapis.com/v1beta/openai/models \
#     -H "Authorization: Bearer $GEMINI_API_KEY"
# Accepted models on this endpoint: gemini-3.8-flash (stable, default), gemini-3.5-flash,
# gemini-3.5-flash-lite, gemini-3.1-pro-preview (strongest).
# Leave the base URL blank unless using a proxy; if set to a Google API root such as
# .../v1beta, TravelClaw adds /openai for you.
# TRAVELCLAW_MODEL_PROVIDER=google
# TRAVELCLAW_MODEL_NAME=gemini-3.8-flash
# TRAVELCLAW_MODELS=gemini-3.8-flash
# TRAVELCLAW_GOOGLE_API_KEY=
# TRAVELCLAW_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# CodeCraft (optional), and the same shape works for any OpenAI-compatible aggregator:
# one key reaches model families this desk has no connector of its own for — Anthropic's
# Claude, Alibaba's Qwen, Zhipu's GLM. Set the provider and key, then list the ids from
#   curl https://codecraftapi.com/v1/models -H "Authorization: Bearer $CODECRAFT_API_KEY"
# CODECRAFT_API_KEY is accepted as an alias for TRAVELCLAW_CODECRAFT_API_KEY. A model id the
# catalog has never heard of runs here with a conservative pace; `claude-opus-5` and friends
# carry a label and a pace of their own. Models in a family whose own key is configured are
# never rerouted through the aggregator.
# TRAVELCLAW_MODEL_PROVIDER=codecraft
# TRAVELCLAW_MODEL_NAME=claude-sonnet-5
# TRAVELCLAW_MODELS=claude-sonnet-5,claude-opus-5
# TRAVELCLAW_CODECRAFT_API_KEY=
# Leave the base URL blank unless using a proxy.
# TRAVELCLAW_CODECRAFT_BASE_URL=https://codecraftapi.com/v1
# Already running something else in the generic slot? Point that slot at the aggregator
# instead and keep TRAVELCLAW_MODEL_PROVIDER=openai:
#   TRAVELCLAW_MODEL_BASE_URL=https://codecraftapi.com/v1
#   TRAVELCLAW_MODEL_API_KEY=$CODECRAFT_API_KEY

# Set to 0 in tests or offline demos. Network-backed tools use labeled desk fallbacks;
# flight and stay search are skipped rather than returning invented offers.
TRAVELCLAW_NETWORK=1

# Set to 0 to skip the sample trip and recurring heartbeat tick.
TRAVELCLAW_SEED=1
TRAVELCLAW_HEARTBEAT=1

# Accounts. Cookie session for the control UI.
# Days a signed-in cookie stays valid before the traveler signs in again.
TRAVELCLAW_SESSION_TTL_DAYS=30
# Set to 1 behind HTTPS so the session cookie is sent Secure. Leave 0 for local http dev.
TRAVELCLAW_COOKIE_SECURE=0
# Google sign-in only renders when this is set, to a Google OAuth web client id.
TRAVELCLAW_GOOGLE_CLIENT_ID=
# Extra origins allowed to call the gateway with credentials, comma separated. Empty means
# same-origin only, which is what serving the control UI from this process needs.
TRAVELCLAW_ALLOWED_ORIGINS=

# Pairing — device token for non-loopback clients.
#
# Direct loopback development (without forwarding headers) needs no token. Any
# client connecting from another address (a channel bot, a CLI, a second box, or any
# caller that reaches this port through a reverse proxy) must present this token in
# the X-Device-Token header (HTTP) or as the deviceToken query parameter (WebSocket).
#
# When unset and a non-loopback caller arrives, the gateway refuses the request with a
# 401 telling the operator how to fix it, rather than silently opening on 0.0.0.0.
# Generate a long random value, e.g.  openssl rand -base64 32  and paste it here.
TRAVELCLAW_DEVICE_TOKEN=

# Proxy mode requires an explicit list of the proxy IPs/CIDRs you operate.
# Example for a proxy running on this same host: 127.0.0.1/32,::1/128
# Never list client networks or the entire internet. /0 and named aliases are refused.
# Requests from these proxies ALWAYS require pairing, even with missing/spoofed XFF.
# Forwarded client identity is used only for guest pacing/pins, not pairing exemptions.
# Leave proxy mode off for direct connections; see docs/security.md for migration.
TRAVELCLAW_TRUST_PROXY=0
TRAVELCLAW_TRUSTED_PROXIES=

# Operator-held provider keys (rates and forecast), resolved by connector name.
# A custom base URL must speak the same shape as the default: Frankfurter for
# currency, Open-Meteo for weather.
TRAVELCLAW_CURRENCY_BASE_URL=
TRAVELCLAW_CURRENCY_API_KEY=
TRAVELCLAW_WEATHER_BASE_URL=
TRAVELCLAW_WEATHER_API_KEY=

# Optional live flight and stay search. Several sources of the same kind can be
# queried in parallel. Each entry needs an id and an apiKey; the key is
# operator-owned, stays on the server, and is never shown to a traveler.
#
# `adapter` says how to reach the source and defaults to "travelclaw", the
# normalized contract (GET {baseUrl}/search/flights, /search/stays, POST /holds):
#   travelclaw  an operator-hosted adapter that implements that contract
#   serpapi     SerpApi, which serves both kinds: Google Flights for flights
#               (engine=google_flights) and Google Hotels for stays
#               (engine=google_hotels). The key travels as a Bearer header;
#               if the vendor refuses that with a 401 the adapter retries once
#               with api_key in the query, the placement SerpApi documents, and
#               remembers it for the process. Leave baseUrl out unless you proxy
#               it; the default is https://serpapi.com
#   flightapi   FlightAPI.io flight prices (onewaytrip / roundtrip). Its key goes
#               in the URL path because the vendor requires it there; TravelClaw
#               keeps that URL out of logs, summaries, and task rows, and scrubs
#               the key from any error text. Flights only.
#
# A source that only quotes prices cannot confirm a hold: offers from `serpapi`
# and `flightapi` are shown with the hold action omitted and a sentence saying so,
# rather than sending an offer id to an endpoint that does not reserve anything.
#
# `cityCodes` is optional and only needed for a vendor that identifies places by
# code instead of by name (`serpapi` can also resolve a city with its own lookup;
# `flightapi` cannot). Values are 3-letter airport codes or Google location ids.
#
# Examples:
# SerpApi for both kinds, with the one key:
# TRAVELCLAW_FLIGHT_PROVIDERS_JSON='[{"id":"serpapi-flights","adapter":"serpapi","apiKey":"replace-me"}]'
# TRAVELCLAW_STAY_PROVIDERS_JSON='[{"id":"serpapi-hotels","adapter":"serpapi","apiKey":"replace-me"}]'
# FlightAPI.io for flights, with operator aliases so a city name can be searched:
# TRAVELCLAW_FLIGHT_PROVIDERS_JSON='[{"id":"flightapi","adapter":"flightapi","apiKey":"replace-me","cityCodes":{"lagos":"LOS","lisbon":"LIS"}}]'
# A compatible operator-hosted adapter, or several of them at once:
# TRAVELCLAW_FLIGHT_PROVIDERS_JSON='[{"id":"global","name":"Global Flights","baseUrl":"https://flight-adapter.example/api","apiKey":"replace-me"},{"id":"regional","name":"Regional Flights","baseUrl":"https://regional-flight-adapter.example/api","apiKey":"replace-me"}]'
# Mixing kinds is allowed: one SerpApi key for hotels plus a regional flight adapter.
TRAVELCLAW_FLIGHT_PROVIDERS_JSON=
TRAVELCLAW_STAY_PROVIDERS_JSON=
# Restaurants are not wired to a desk yet. They will read the same way when they
# are — a list of sources with an adapter and a key (see docs/roadmap.md).
# TRAVELCLAW_RESTAURANT_PROVIDERS_JSON=

# Optional fallback market passed to provider adapters only for keys a traveler's
# own message left unstated ("price it in NGN", "I'm booking from Nigeria").
# Booker country is the point of sale (not the route origin, destination, or
# passport nationality). Leave blank when an adapter has its own market profile.
TRAVELCLAW_BOOKER_COUNTRY=
TRAVELCLAW_SEARCH_CURRENCY=
TRAVELCLAW_SEARCH_LANGUAGE=

# Legacy single-provider fallback. Used only when the matching *_PROVIDERS_JSON
# setting is blank. New deployments should use the provider lists above.
TRAVELCLAW_FLIGHT_BASE_URL=
TRAVELCLAW_FLIGHT_API_KEY=
TRAVELCLAW_STAY_BASE_URL=
TRAVELCLAW_STAY_API_KEY=

# OPTIONAL browser research fallback (#25). Disabled unless BOTH are configured.
# The worker is a separate process/container, never an existing signed-in browser.
# URLs and worker tokens are operator-only, never model arguments or frontend values.
TRAVELCLAW_BROWSER_WORKER_URL=
TRAVELCLAW_BROWSER_WORKER_TOKEN=
# Worker ONLY: explicit authorized public search sites. See docs/browser-agent.md.
# Exact origins (including needed assets) and search-only POST paths; no wildcards.
# This example is a placeholder, NOT a tested or real airline integration.
# TRAVELCLAW_BROWSER_SITES_JSON='[{"id":"public-airline","name":"Authorized airline","kind":"flight","startUrl":"https://airline.example/search","origins":["https://airline.example"],"searchPostPaths":["/search"]}]'
TRAVELCLAW_BROWSER_SITES_JSON=
